DATABASE_URL={% if cookiecutter.include_postgres == "yes" %}postgresql://{{ cookiecutter.postgres_user }}:{{ cookiecutter.postgres_password }}@localhost:5432/{{ cookiecutter.postgres_database }}{% else %}sqlite:///./app.db{% endif %}
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
APP_NAME={{ cookiecutter.project_name }}
# Leave blank to disable API-key protection during local development.
{% if cookiecutter.include_api_key_auth == "yes" %}API_KEY=
{% endif %}
{% if cookiecutter.include_postgres == "yes" %}
POSTGRES_USER={{ cookiecutter.postgres_user }}
POSTGRES_PASSWORD={{ cookiecutter.postgres_password }}
POSTGRES_DB={{ cookiecutter.postgres_database }}
{% endif %}
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
